# ---- Prisma(x) Forum API configuration ----
# Copy to `.env` and edit. All values have sensible defaults for local demo use.

DATABASE_URL=sqlite:///./forum.db

# Comma-separated origins allowed to call the API with credentials (the frontend).
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://34.186.168.140:3001

# ---- Auth ----
# "demo"  -> built-in stub login (default; for local dev & demos)
# "prismax" -> use the PrismaX host user system (see app/auth/prismax.py)
AUTH_PROVIDER=demo

# Demo adapter cookie + signing secret. CHANGE the secret for any shared deploy.
SESSION_COOKIE=forum_session
SESSION_SECRET=dev-only-change-me-in-production
SESSION_TTL_HOURS=336

# ---- PrismaX adapter (only read when AUTH_PROVIDER=prismax) ----
# PRISMAX_TOKEN_SOURCE=bearer        # "bearer" header, or a cookie name
# PRISMAX_JWT_ALGORITHMS=RS256
# PRISMAX_JWT_PUBLIC_KEY=
# PRISMAX_JWT_SECRET=
# PRISMAX_JWT_AUDIENCE=
# PRISMAX_JWT_ISSUER=
# PRISMAX_CLAIM_SUB=sub
# PRISMAX_CLAIM_NAME=name
# PRISMAX_CLAIM_EMAIL=email
